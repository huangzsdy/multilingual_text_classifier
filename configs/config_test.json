{
  "model_config": {
    "model_name": "models/FacebookAI/xlm-roberta-base",
    "num_labels": 2
  },
  "data_config": {
    "positive_sample_configs": [
        "-1 content /data/multilingual_projects/trainning_data/en/filtered_result/train_pos.jsonl"
    ],
    "negative_sample_configs": [
        "-1 content /data/multilingual_projects/trainning_data/en/filtered_result/train_neg_target.jsonl"
    ],
    "max_length": 512,
    "test_size": 0.2,
    "random_seed": 42
  },
  "training_config": {
    "output_dir": "./output/results_en",
    "num_train_epochs": 3,
    "per_device_train_batch_size": 8,
    "per_device_eval_batch_size": 8,
    "warmup_steps": 500,
    "weight_decay": 0.01,
    "learning_rate": 2e-5,
    "logging_dir": "./logs",
    "eval_strategy": "epoch",
    "save_strategy": "epoch",
    "save_total_limit": 2,
    "load_best_model_at_end": true,
    "metric_for_best_model": "accuracy"
  }
}
