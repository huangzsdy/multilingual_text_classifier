{
    "model_config": {
    "model_name": "FacebookAI/xlm-roberta-base",
    "model_cache_dir": "models/FacebookAI/xlm-roberta-base",
    "model_path": "models/FacebookAI/xlm-roberta-base",
    "num_labels": 2,
    "attention_probs_dropout_prob": 0.1,  
    "hidden_dropout_prob": 0.1,           
    "hidden_size": 768,                   
    "intermediate_size": 3072,            
    "max_position_embeddings": 512,      
    "num_attention_heads": 12,            
    "num_hidden_layers": 12               
    },
  "data_config": {
    "positive_sample_path":"./data/positive_samples.jsonl", 
    "negative_sample_path": "./data/negative_samples.jsonl",
    "max_length": 512,
    "test_size": 0.2,
    "random_seed": 42
  },
  "training_config": {
    "output_dir": "./results",
    "num_train_epochs": 3,
    "per_device_train_batch_size": 8,
    "per_device_eval_batch_size": 8,
    "warmup_steps": 500,
    "weight_decay": 0.01,
    "learning_rate": 2e-5,
    "logging_dir": "./logs",
    "logging_steps": 100,
    "eval_strategy": "epoch", 
    "save_strategy": "epoch",
    "save_total_limit": 2,
    "load_best_model_at_end": true,
    "metric_for_best_model": "accuracy"
  }
}


